PORT=4101
MONGODB_URI=mongodb://127.0.0.1:27017/shine_auth
# Generate a random secret (at least 32 bytes). Copy SAME value to core-api.
JWT_SECRET=
# Integer seconds; default 3600 (one hour).
JWT_EXPIRES_IN_SECONDS=3600
CORE_API_URL=http://127.0.0.1:4102
# One-time fresh database bootstrap; set these only for npm run bootstrap:admin, then remove.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Demo OTP is logged to the Auth Service console; never sends SMS. Disable for public deployments.
DEMO_OTP_ENABLED=true
# Tests create a unique collection and remove only that collection.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/shine_auth_test
