PORT=4102
MONGODB_URI=mongodb://127.0.0.1:27017/shine_core
# Same random secret (at least 32 bytes) as auth-service. Never commit .env.
JWT_SECRET=
AUTH_SERVICE_URL=http://127.0.0.1:4101
# Catalog, Work Shift and appointments persist in the Core database above.
# Integration tests use a uniquely named collection and clean up only that collection.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/shine_core_test

# Tài khoản chung đã kết nối SePay. Chỉ cấu hình trên máy chủ.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
# API Token chỉ lưu ở Core API local. Không đưa vào app hoặc Git.
SEPAY_API_TOKEN=
