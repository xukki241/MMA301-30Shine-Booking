{
  "name": "@shine/core-api",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "docs": "node src/docs/serve.js",
    "test": "node --test test/auth.test.js test/booking.test.js test/catalog.test.js test/work-shift.test.js test/docs.test.js",
    "test:catalog": "node --test test/catalog.test.js",
    "test:booking": "node --test test/booking.test.js",
    "test:work-shift": "node --test test/work-shift.test.js",
    "test:docs": "node --test test/docs.test.js",
    "test:booking:integration": "node --env-file-if-exists=.env --test test/booking.integration.js"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.26",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.3"
  }
}
