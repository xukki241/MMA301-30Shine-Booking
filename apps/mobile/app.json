{
  "expo": {
    "name": "30Shine Booking",
    "slug": "shine-booking-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "shinebooking",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.mma301.shinebooking",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép lưu mã QR thanh toán vào thư viện ảnh.",
          "savePhotosPermission": "Cho phép lưu mã QR thanh toán vào thư viện ảnh.",
          "granularPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
